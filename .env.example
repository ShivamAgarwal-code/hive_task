# ---------------------------------------------------------------------------
# Storage driver selection
#   supabase -> real Postgres backend (use this for the deployed app)
#   file     -> local JSON file at ./.data/db.json (dev/offline demo only)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=file

# ---------------------------------------------------------------------------
# Supabase (required only when STORAGE_DRIVER=supabase)
# Find these in Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service role key is used ONLY on the server (API routes / server actions).
# Never expose it to the browser. Keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anon key is safe for the browser but this app talks to the DB only server-side,
# so it is optional. Included for completeness.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
